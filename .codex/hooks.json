{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Write|Edit|apply_patch|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/bin/jargon-hook.ts\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
